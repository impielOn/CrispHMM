        "    print(f\"  P(init states): {init_values}\\n\")\n",
        "\n",
        "    print(\"=== Emission Parameters (Regression-based) ===\")\n",
        "    baseline_means = torch.sigmoid(b_mu_hat)\n",
        "\n",
